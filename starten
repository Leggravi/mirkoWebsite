#!/usr/bin/env bash
set -euo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")"

if ! command -v ruby >/dev/null 2>&1; then
  echo "Fehler: Ruby ist nicht installiert oder nicht im PATH." >&2
  echo "Installiere Ruby 3.x und Bundler und starte danach ein neues Terminal." >&2
  exit 1
fi

if ! command -v bundle >/dev/null 2>&1; then
  echo "Fehler: Bundler ist nicht installiert oder nicht im PATH." >&2
  echo "Installiere Bundler mit: gem install bundler" >&2
  exit 1
fi

if ! bundle check >/dev/null 2>&1; then
  echo "Ruby-Abhängigkeiten fehlen; installiere sie mit 'bundle install' ..."
  bundle install
fi

exec bundle exec jekyll serve --livereload --host 127.0.0.1 "$@"
